<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>write chat new</title>
</head>
<body>
    <h3>write your new chat!</h3>
    <form method="post" action="/chats">
        <input placeholder="who are you" name="from"/>
        <br>
        <textarea name="msg" placeholder=" write your msg" ></textarea>
